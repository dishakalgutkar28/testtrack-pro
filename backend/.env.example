# ========================================
# TestTrack Pro - Environment Configuration
# ========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to source control

# ========================================
# Application
# ========================================
NODE_ENV=development
PORT=5000

# ========================================
# Database Configuration
# ========================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_password
DB_NAME=testtrack
DB_POOL_LIMIT=10
DB_CONNECTION_TIMEOUT=10000

# ========================================
# JWT Configuration
# ========================================
# Generate strong secrets using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_complex_jwt_secret_key_minimum_32_chars_please_change_this
JWT_EXPIRY=24h
REFRESH_SECRET=your_complex_refresh_secret_minimum_32_chars_please_change_this
REFRESH_EXPIRY=7d

# ========================================
# Email Service Configuration
# ========================================
# Choose one provider: gmail, sendgrid, ses, or smtp (generic)
EMAIL_PROVIDER=smtp
EMAIL_FROM=TestTrack Pro <noreply@testtrack.com>

# Gmail Configuration (recommended for small-scale)
# Use App Password from: https://myaccount.google.com/apppasswords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# SendGrid Configuration
# Get API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.your_api_key_here

# AWS SES Configuration
SES_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SES_SMTP_USER=your_ses_smtp_username
SES_SMTP_PASS=your_ses_smtp_password

# Generic SMTP Configuration (for other providers)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

# ========================================
# Frontend Configuration
# ========================================
FRONTEND_URL=http://localhost:3000

# ========================================
# Security
# ========================================
# Allowed origins for CORS (comma-separated for multiple)
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# ========================================
# Logging (Optional - default: console)
# ========================================
LOG_LEVEL=info
# LOG_FILE=logs/app.log

# ========================================
# Rate Limiting (Optional - for future implementation)
# ========================================
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
